<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="FieldForceConnect Test Suite" verbose="1" parallel="none">

    <listeners>
        <listener class-name="com.fieldforce.utils.ExtentReportListener"/>
    </listeners>

    <parameter name="browser" value="chrome"/>
    <parameter name="headless" value="true"/>

    <test name="Authentication Tests">
        <classes>
            <class name="com.fieldforce.tests.LoginTest"/>
        </classes>
    </test>

    <test name="Attendance PunchIn Tests">
        <classes>
            <class name="com.fieldforce.tests.PunchInTest"/>
        </classes>
    </test>

    <test name="Customer Management Tests">
        <classes>
            <class name="com.fieldforce.tests.CustomerTest"/>
        </classes>
    </test>

</suite>
